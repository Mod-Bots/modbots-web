{
  "name": "modbots-web",
  "version": "0.0.1-beta",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "dev:next": "next dev",
    "configure:github-app": "node scripts/configure-github-app.mjs",
    "styles:build": "sass src/styles/globals.scss src/app/globals.css --no-source-map && biome format --write src/app/globals.css",
    "styles:watch": "sass --watch src/styles/globals.scss:src/app/globals.css --no-source-map",
    "build": "npm run styles:build && next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings",
    "test:composer": "node --experimental-strip-types --test src/components/chatroom/emoji-data.test.mjs src/components/chatroom/media-player-data.test.mjs src/data/content-lifecycle.test.mjs",
    "test:notifications": "node --experimental-strip-types --test src/notifications/room-notifications.test.mjs",
    "test:forms": "node --experimental-strip-types --test src/app/api/github-issue-routes.test.mjs",
    "test:rooms": "node --experimental-strip-types --test src/data/room-capabilities.test.mjs",
    "format": "biome format --write"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "html2canvas-pro": "^2.2.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "sass": "^1.101.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
