#!/bin/sh
set -eu

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

echo "Running Biome before push..."
if [ -f "./node_modules/.bin/biome.cmd" ]; then
  biome_command="./node_modules/.bin/biome.cmd"
else
  biome_command="./node_modules/.bin/biome"
fi

if ! "$biome_command" check; then
  echo ""
  echo "Push blocked: Biome lint failed."
  echo "Run npm run lint, fix every reported error, then push again."
  exit 1
fi
